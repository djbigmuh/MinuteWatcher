<?xml version="1.0" encoding="utf-8"?><!--
    Canonical launcher icon layout. Do not move, duplicate or rasterize these files:
    - adaptive-icon XML: app/src/main/res/mipmap-anydpi/ic_launcher.xml
    - vector parts: app/src/main/res/drawable/ic_launcher_background.xml, ic_launcher_foreground.xml
    With minSdk 26 the adaptive vector icon covers all densities; png/webp variants are not required.
    The android namespace URI must be http://schemas.android.com/apk/res/android
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
