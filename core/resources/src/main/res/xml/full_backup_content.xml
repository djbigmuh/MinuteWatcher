<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- DataStore and SharedPreferences are excluded from cloud backup to protect privacy (SIM IDs, usage statistics) -->
    <!-- Only device-to-device transfer is allowed for these files (configured in data_extraction_rules.xml) -->
    <exclude domain="file" path="datastore/" />
    <exclude domain="sharedpref" path="." />

    <!-- Diagnostic log files never leave the device -->
    <exclude
        domain="file"
        path="logs.txt" />
    <exclude
        domain="file"
        path="logs.old.txt" />
</full-backup-content>
