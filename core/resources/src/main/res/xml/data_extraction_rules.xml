<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- DataStore and SharedPreferences are excluded from cloud backup to protect privacy (SIM IDs, usage statistics) -->
    </cloud-backup>
    <device-transfer>
        <!-- Allow data transfer between devices during explicit setup -->
        <include domain="sharedpref" path="."/>
        <include domain="file" path="datastore/"/>
    </device-transfer>
</data-extraction-rules>
