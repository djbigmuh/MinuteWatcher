<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Allow SharedPreferences backup -->
        <include domain="sharedpref" path="."/>
        <!-- DataStore is excluded from cloud backup to protect privacy (SIM IDs) -->
    </cloud-backup>
    <device-transfer>
        <!-- Allow SharedPreferences transfer between devices -->
        <include domain="sharedpref" path="."/>
        <include domain="file" path="datastore/"/>
    </device-transfer>
</data-extraction-rules>
