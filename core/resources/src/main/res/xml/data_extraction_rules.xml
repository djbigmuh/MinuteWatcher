<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Разрешаем бэкап SharedPreferences -->
        <include domain="sharedpref" path="."/>
        <include domain="file" path="datastore/"/>
    </cloud-backup>
    <device-transfer>
        <!-- Разрешаем передачу SharedPreferences между устройствами -->
        <include domain="sharedpref" path="."/>
        <include domain="file" path="datastore/"/>
    </device-transfer>
</data-extraction-rules>
