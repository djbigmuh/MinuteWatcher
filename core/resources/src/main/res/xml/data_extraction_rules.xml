<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Usage data, settings and SIM identifiers never leave the device via cloud backup. -->
        <exclude
            domain="file"
            path="datastore/" />
        <exclude
            domain="sharedpref"
            path="." />

        <!-- Diagnostic log files never leave the device -->
        <exclude
            domain="file"
            path="logs.txt" />
        <exclude
            domain="file"
            path="logs.old.txt" />
    </cloud-backup>
    <device-transfer>
        <!-- Allow data transfer between devices during explicit setup -->
        <include domain="sharedpref" path="."/>
        <include
            domain="file"
            path="." />
        <include domain="file" path="datastore/"/>

        <!-- Diagnostic log files never leave the device -->
        <exclude
            domain="file"
            path="logs.txt" />
        <exclude
            domain="file"
            path="logs.old.txt" />
    </device-transfer>
</data-extraction-rules>
