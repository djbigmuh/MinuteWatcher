<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme -->
    <style name="Base.Theme.MinuteWatcher" parent="Theme.Material3.DayNight">
        <!-- Material3 colors for light theme -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/onPrimary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/onSurface</item>
        <item name="colorSurfaceVariant">@color/surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/onSurfaceVariant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Material3.Dialog.Alert</item>
        <item name="android:alertDialogTheme">@style/ThemeOverlay.Material3.Dialog.Alert</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Material3.Dialog.Alert</item>

        <!-- Component styles -->
        <item name="materialButtonStyle">@style/Widget.Material3.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Material3.Button.OutlinedButton</item>
        <item name="checkboxStyle">@style/Widget.Material3.CompoundButton.CheckBox</item>

        <!-- System colors -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Main application theme -->
    <style name="Theme.MinuteWatcher" parent="Base.Theme.MinuteWatcher">
    </style>

    <!-- Theme without ActionBar -->
    <style name="Theme.MinuteWatcher.NoActionBar" parent="Theme.MinuteWatcher">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Theme for widget settings -->
    <style name="Theme.MinuteWatcher.WidgetSettings" parent="Theme.MinuteWatcher">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

</resources>
