    <!-- About Dialog -->
    <string name="about_title">பற்றி</string>
    <string name="about_message">MinuteWatcher என்பது மீதமுள்ள நிமிடங்கள் மற்றும் மொபைல் தரவு பயன்பாட்டைக் கண்காணிப்பதற்கான ஒரு பயன்பாடாகும்.</string>
    <string name="about_author_name">ஆசிரியர்: Pavel Mukhin</string>
    <string name="about_translation_feedback">ரஷ்யன் அல்லாத மொழிகளுக்கு இயந்திர மொழிபெயர்ப்புகள் பயன்படுத்தப்படுகின்றன. பிழை அல்லது இயற்கையற்ற சொற்றொடரைக் கண்டால், அதை மேம்படுத்த உதவ டெவலப்பருக்கு மின்னஞ்சல் அனுப்பவும்.</string>
