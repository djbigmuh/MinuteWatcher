    <string name="traffic_tracking_limitation_title">டேட்டா கண்காணிப்பு வரம்பு</string>
    <string name="traffic_tracking_limitation_body">ஆண்ட்ராய்டு முழு சாதனத்திற்குமான மொத்த மதிப்பாக மொபைல் தரவு பயன்பாட்டை வழங்குகிறது.\n\nMinuteWatcher அனைத்து மொபைல் டேட்டாவையும் உங்கள் கணினி அமைப்புகளில் \"இயல்புநிலை டேட்டா சிம்\" ஆகத் தேர்ந்தெடுக்கப்பட்ட சிம் கார்டுக்கு ஒதுக்குகிறது.</string>
    <string name="tracking_banner_phone_permission">சிம் கார்டுகளை அடையாளம் காண தொலைபேசி அனுமதி தேவை.</string>
    <string name="tracking_banner_usage_access">மொபைல் தரவு பயன்பாட்டைக் துல்லியமாகக் கண்காணிக்க பயன்பாட்டு அணுகல் தேவை.</string>
    <string name="tracking_banner_sim_discovery_error">சிம் கார்டுகளைக் கண்டறிய முடியவில்லை. மீண்டும் முயற்சிக்கவும்.</string>
    <string name="tracking_banner_traffic_error">டேட்டா அமைப்புகளை புதுப்பிப்பதில் பிழை ஏற்பட்டது.</string>
    <string name="tracking_banner_calls_error">அழைப்புக் கண்காணிப்புத் தரவைப் புதுப்பிப்பதில் பிழை ஏற்பட்டது.</string>
    <string name="tracking_banner_appsearch_error">AppSearch இன்டெக்சிங் தோல்வியடைந்தது.</string>
    <string name="tracking_banner_shortcuts_error">டைனமிக் குறுக்குவழிகள் புதுப்பிப்பு தோல்வியடைந்தது.</string>
    <string name="tracking_banner_notification_permission">பயன்பாட்டு எச்சரிக்கைகளைப் பெற அறிவிப்பு அனுமதி பரிந்துரைக்கப்படுகிறது.</string>
    <string name="tracking_banner_widget_error">கணினி வரம்புகள் காரணமாக விட்ஜெட்டைப் புதுப்பிக்க முடியாது.</string>
    <string name="tracking_banner_inaccurate_calls">சில அழைப்புகளை சிம் கார்டுடன் பொருத்த முடியவில்லை.</string>
    <string name="tracking_banner_calls_attribution_error">ஒரே நேரத்தில் பல அழைப்புகள் கண்டறியப்பட்டன. சிம் கார்டை தீர்மானிக்க முடியவில்லை.</string>
    <string name="tracking_banner_observation_failed">பல பிழைகளுக்குப் பிறகு தரவு கண்காணிப்பு சேவை நிறுத்தப்பட்டது. பயன்பாட்டை மீண்டும் தொடங்கவும்.</string>
    <string name="tracking_banner_storage_degraded">சேமிப்பகம் குறைக்கப்பட்டது: பயன்பாடு மீண்டும் தொடங்கப்பட்ட பிறகு புள்ளிவிவரங்கள் மீட்டமைக்கப்படலாம்.</string>
