    <!--
      Plural rules per CLDR: https://www.unicode.org/cldr/charts/latest/supplemental/language_plural_rules.html
      Arabic requires: zero (0), one (1), two (2), few (3-10), many (11-99), other (everything else).
      Missing any quantity causes Lint fatal error and runtime fallback to 'other'.
    -->
    <!--
      Strict Android localization contract: Missing quantity causes Lint fatal error
      and runtime fallback to 'other'. All quantities must be defined for each locale.
    -->
    <plurals name="minutes_plurals">
        <item quantity="zero">%1$d دقيقة</item>
        <item quantity="one">دقيقة واحدة</item>
        <item quantity="two">دقيقتان</item>
        <item quantity="few">%1$d دقائق</item>
        <item quantity="many">%1$d دقيقة</item>
        <item quantity="other">%1$d دقيقة</item>
    </plurals>
    <plurals name="days_plurals">
        <item quantity="zero">%1$d يوم</item>
        <item quantity="one">يوم واحد</item>
        <item quantity="two">يومان</item>
        <item quantity="few">%1$d أيام</item>
